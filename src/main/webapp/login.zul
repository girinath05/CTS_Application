<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS - Login"?>
<zk>
<window apply="com.iispl.controller.LoginController"
        width="100%"
        style="min-height:100vh; background:#F5F7FA;
               font-family:'Segoe UI',Arial,sans-serif;">

    <div style="display:flex; align-items:center; justify-content:center; min-height:100vh;">
        <div style="width:420px; padding:40px;">

            <!-- Logo Section -->
            <div style="text-align:center; margin-bottom:24px;">
                <label value="🏦" style="font-size:48px; display:block;"/>
                <label value="CTS"
                       style="font-size:28px; color:#1A3C6E; font-weight:bold; display:block;"/>
                <label value="Cheque Truncation System"
                       style="color:#666; display:block; font-size:14px;"/>
            </div>

            <!-- Login Card -->
            <div style="background:white; border:1px solid #D0D7E2; border-radius:12px;
                        padding:32px; box-shadow:0 4px 16px rgba(0,0,0,0.08);">

                <label value="Sign In"
                       style="font-size:20px; font-weight:bold; display:block; margin-bottom:20px;"/>

                <label value="Username"
                       style="font-size:13px; color:#374151; font-weight:600;
                              display:block; margin-bottom:4px;"/>
                <textbox id="tbUsername"
                         width="100%"
                         placeholder="Enter username"
                         style="margin-bottom:14px; padding:9px 12px;
                                border:1px solid #D1D5DB; border-radius:8px; font-size:14px;"/>

                <label value="Password"
                       style="font-size:13px; color:#374151; font-weight:600;
                              display:block; margin-bottom:4px;"/>
                <textbox id="tbPassword"
                         type="password"
                         width="100%"
                         placeholder="Enter password"
                         style="margin-bottom:20px; padding:9px 12px;
                                border:1px solid #D1D5DB; border-radius:8px; font-size:14px;"/>

                <button id="btnLogin"
                        label="LOGIN"
                        width="100%"
                        style="background:#1A3C6E; color:white; border:none;
                               padding:12px; border-radius:8px;
                               font-size:14px; font-weight:700; cursor:pointer;"/>

                <separator height="12px"/>

                <!-- lblError id must match LoginController @Wire -->
                <label id="lblError"
                       value=""
                       style="color:#D32F2F; font-size:13px; display:block; text-align:center;"/>

                <separator height="8px"/>

                <label value="Username: admin   |   Password: admin"
                       style="font-size:11px; color:#999; display:block; text-align:center;"/>
            </div>

        </div>
    </div>

</window>
</zk>