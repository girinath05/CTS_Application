<?xml version="1.0" encoding="UTF-8"?>
<?page title="CTS - Clearing House"?>

<?component name="pageheader" macroURI="/components/pageHeader.zul" class="com.cts.components.PageHeader"?>

<zk>
<window apply="com.iispl.controller.ClearingHouseController"
        width="100%"
        style="min-height:100vh; background:#F5F7FA;
               font-family:'Segoe UI',Arial,sans-serif;">

    <pageheader userLabel="🏛️ Clearing House" />

    <div style="padding:14px 28px;">

        <!-- Back button -->
        <div style="margin-bottom:12px;">
            <button id="btnDashboard"
                    label="← Back to Dashboard"
                    style="background:transparent; color:#1A3C6E; border:none;
                           font-size:13px; cursor:pointer; font-weight:600;
                           text-decoration:underline;"/>
        </div>

        <!-- Message label -->
        <label id="lblMessage" value=""
               style="font-size:13px; display:block; margin-bottom:10px;"/>

        <!-- TAB BUTTONS -->
        <div style="display:flex; gap:10px; margin-bottom:16px;">
            <button id="btnPending"
                    label="📋 Pending Batches"
                    style="padding:9px 20px; background:#1A3C6E; color:white;
                           border:2px solid #1A3C6E; border-radius:8px;
                           font-size:13px; font-weight:600; cursor:pointer;"/>
            <button id="btnApproved"
                    label="✔ Approved Batches"
                    style="padding:9px 20px; background:white; color:#2E7D32;
                           border:2px solid #2E7D32; border-radius:8px;
                           font-size:13px; font-weight:600; cursor:pointer;"/>
            <button id="btnRejected"
                    label="✘ Rejected Batches"
                    style="padding:9px 20px; background:white; color:#DC2626;
                           border:2px solid #DC2626; border-radius:8px;
                           font-size:13px; font-weight:600; cursor:pointer;"/>
        </div>

        <!-- BATCH TABLE -->
        <div style="background:white; border:1px solid #E5E7EB; border-radius:12px;
                    padding:20px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">

            <label id="lblCurrentView"
                   value="Viewing: Pending Batches"
                   style="font-size:17px; font-weight:700; color:#1A3C6E;
                          display:block; margin-bottom:14px;"/>

            <label id="lblEmptyBatches"
                   value="No batches found."
                   visible="false"
                   style="color:#9CA3AF; font-size:13px; display:block; margin-bottom:8px;"/>

            <listbox id="lbBatches" style="width:100%;" rows="12">
                <listhead>
                    <listheader label="Batch ID"     width="150px"/>
                    <listheader label="Cheque Count" width="130px"/>
                    <listheader label="Status"       width="130px"/>
                    <listheader label="Actions"/>
                </listhead>
            </listbox>
        </div>

    </div>
</window>
</zk>