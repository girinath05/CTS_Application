<?xml version="1.0" encoding="UTF-8"?>
<zk>
    <style>
        .module-card {
            background: #FAFBFD;
            border: 1px solid #E5E7EB;
            border-radius: 14px;
            padding: 22px;
            display: flex;
            align-items: center;
            gap: 18px;
            transition: 0.2s;
            cursor: pointer;
            width: 100%;
            box-sizing: border-box;
            font-family: "Segoe UI", Arial, sans-serif;
        }
        .module-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
            border-color: #2563A8;
        }
        .module-icon {
            width: 60px;
            height: 60px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: white;
            flex-shrink: 0;
        }
        .module-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .module-title {
            font-size: 17px;
            font-weight: 700;
            color: #1F2937;
            display: block;
        }
        .module-desc {
            font-size: 13px;
            color: #6B7280;
            line-height: 1.5;
            display: block;
        }
    </style>

    <div id="mc_card" sclass="module-card" width="100%">
        <label id="mc_icon"  sclass="module-icon"  value="📄" />
        <div sclass="module-info">
            <label id="mc_title" sclass="module-title" value="Module" />
            <label id="mc_desc"  sclass="module-desc"  value="" />
        </div>
    </div>
</zk>