<?xml version="1.0" encoding="UTF-8"?>
<zk>

    <style>
        .ph-navbar {
            background: linear-gradient(135deg, #1A3C6E, #2563A8);
            padding: 16px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 6px 25px rgba(0,0,0,0.12);
            font-family: "Segoe UI", Arial, sans-serif;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .ph-brand {
            display:flex;
            align-items:center;
            gap:450px;
        }

        .ph-brand-icon {
            width:50px;
            height:50px;
            border-radius:50%;
            background:rgba(255,255,255,0.2);
            display:flex;
            align-items:center;
            justify-content:center;
            font-size:24px;
            backdrop-filter: blur(6px);
            box-shadow: inset 0 0 8px rgba(255,255,255,0.2);
        }

        .ph-brand-title {
            font-size:22px;
            font-weight:700;
            color:white;
            letter-spacing:0.5px;
            gap: 250px
        }

        .ph-brand-sub {
            font-size:12px;
            color:rgba(255,255,255,0.85);
            margin-top:2px;
            gap: 250px
        }

        .ph-right {
            display:flex;
            align-items:center;
            gap:350px;
        }

        .ph-user {
            color:white;
            font-size:14px;
            font-weight:600;
            padding:6px 12px;
            border-radius:20px;
            background: rgba(255,255,255,0.1);
            transition: all 0.3s ease;
           
            
        }

        .ph-user:hover {
            background: rgba(255,255,255,0.2);
        }

        .ph-logout-btn {
            background:white;
            color:#1A3C6E;
            padding:10px 20px;
            border-radius:25px;
            font-size:14px;
            font-weight:700;
            border:none;
            cursor:pointer;
            transition: all 0.3s ease;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .ph-logout-btn:hover {
            background:#E8F0FE;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.15);
        }

        .ph-logout-btn:active {
            transform: scale(0.96);
        }
    </style>

    <div sclass="ph-navbar">
        <div sclass="ph-brand">
            <div sclass="ph-brand-icon">🏦</div>
            <div>
                <div sclass="ph-brand-title">CTS Portal</div>
                <div sclass="ph-brand-sub">Cheque Truncation System</div>
            </div>
        </div>

        <div sclass="ph-right">
            <label id="ph_userLabel"
                   sclass="ph-user"
                   value="👤 User" />
            <button id="ph_btnLogout"
                    sclass="ph-logout-btn"
                    label="Logout" />
        </div>
    </div>

</zk>